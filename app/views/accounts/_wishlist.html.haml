.container.mx-auto.p-4
  .overflow-x-auto
    .min-w-full
      %table.w-full
        %thead
          %tr.border-b
            %th.text-left.py-2 Product
            %th.text-center.py-2 Price
            %th.text-end.py-2 Action
        %tbody
          -wishlists.each do |wishlist|
            %tr.border-b
              %td.py-4
                .flex.items-center
                  =button_to remove_wishlist_account_path(product_id: wishlist.product.id), method: :delete do
                    =icon("fa-solid", "xmark")
                  =image_tag(wishlist.product.product_image.variant(resize_to_fill: [100,100]))
                  =wishlist.product.name
              %td.py-4.text-center
                =wishlist.product.price
              %td.py-4.text-end
                =button_to "Add to cart", add_to_cart_cart_path(wishlist.product, quantity: 1), class: "btn-cta"

